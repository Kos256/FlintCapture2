    <None Remove="assets\sounds\dbox no alt.wav" />
    <None Remove="assets\sounds\dbox no.wav" />
    <None Remove="assets\sounds\Desktop.ini" />
    <None Remove="assets\sounds\dismiss legacy.wav" />
    <None Remove="assets\sounds\dismiss single.wav" />
    <None Remove="assets\sounds\dismiss.wav.asd" />
    <None Remove="assets\sounds\editor exception.wav" />
    <None Remove="assets\sounds\editor open.wav.asd" />
    <None Remove="assets\sounds\ocr fail.wav" />
    <None Remove="assets\sounds\ocr start.wav" />
    <None Remove="assets\sounds\ocr start.wav.asd" />
